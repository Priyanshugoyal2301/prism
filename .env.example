# Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env.
# The system runs in rules-only mode if LLM_API_KEY is blank.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Option A: OpenAI (default)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CONTROLLER_MODEL=gpt-4o-mini
LLM_SYNTHESIZER_MODEL=gpt-4o

# Option B: Google Gemini via AI Studio (set LLM_PROVIDER=gemini)
# LLM_PROVIDER=gemini
# LLM_API_KEY=<your-gemini-api-key-from-aistudio.google.com>
# LLM_CONTROLLER_MODEL=gemini-2.0-flash
# LLM_SYNTHESIZER_MODEL=gemini-2.5-flash

# ── Retrieval ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FAISS_INDEX_TYPE=flat          # flat | hnsw
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
TOP_K_RETRIEVAL=20
TOP_K_RERANK=4
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Controller ───────────────────────────────────────────────────────────────
CONTROLLER_DEBOUNCE_S=0.4
CONTROLLER_SIMILARITY_THRESHOLD=0.92
CONTROLLER_MIN_TOKENS=8
CONTROLLER_DRIFT_THRESHOLD=0.15
CONTROLLER_USE_LLM_FALLBACK=false

# ── Decomposer ───────────────────────────────────────────────────────────────
DECOMPOSER_MAX_SUBQUERIES=4
DECOMPOSER_ORTHOGONALITY_THRESHOLD=0.85

# ── Session Store ────────────────────────────────────────────────────────────
SESSION_TTL_S=1800
SESSION_MAX_CONCURRENT=100

# ── Synthesis & Grounding ────────────────────────────────────────────────────
GROUNDING_COSINE_THRESHOLD=0.35
GROUNDING_LEXICAL_THRESHOLD=0.20
SYNTHESIS_STREAM_TOKENS=true

# ── Security ─────────────────────────────────────────────────────────────────
AUTH_MODE=open                 # open | token
APP_API_TOKEN=
DEBUG_ADMIN=false
ADMIN_TOKEN=
CORS_ORIGINS=*
LOG_TEXT=false                 # set true locally to log full transcript text

# ── Observability ─────────────────────────────────────────────────────────────
TELEMETRY_LOG_PATH=logs/telemetry.jsonl
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHUNKS_PER_SEC=20
RATE_LIMIT_SESSIONS_PER_MIN=30
MAX_CHUNK_LENGTH=2000
